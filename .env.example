# Tree of Life Phase 1 Environment Configuration
APP_ENV=development
API_V1_PREFIX=/api/v1
PORT=8000

# Storage & Privacy
UPLOAD_DIR=data/uploads_tmp
CROPS_DIR=data/processed/crops
RETENTION_HOURS=24
ESCALATION_RETENTION_DAYS=180

# Service Adapter Selection (Set to false for deterministic CPU mocks)
USE_REAL_FLORENCE=false
USE_REAL_QWEN=false
USE_REAL_EFFICIENTNET=false

# Model Residency & GPU Scheduling
MODEL_RESIDENCY=on_demand
DEVICE=cpu
HF_HOME=data/models/huggingface
HF_HUB_OFFLINE=0

# Policy Settings
QWEN_POLICY=always
QUALITY_MIN=0.60
GENOMIC_ALLOW_PLACEHOLDER=true

# Database (MongoDB)
DATABASE_TYPE=mongodb
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=tree_of_life
